# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
desktop.ini

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# jarvis: local data never leaves this machine
jarvis.db
jarvis.db-journal
jarvis.db-wal
jarvis.db-shm
/statements
/ObsidianVault
/backups
/temp_notes


# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python sidecars: venvs, caches, vector-db data
sidecars/**/.venv/
sidecars/**/__pycache__/
sidecars/**/.pytest_cache/
sidecars/textbook-rag/data/
