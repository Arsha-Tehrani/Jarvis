# LLM provider: "ollama" (default) or "anthropic"
LLM_PROVIDER=ollama
# OpenAI-compatible base URL for Ollama
LLM_BASE_URL=http://localhost:11434/v1
# Model name to use (pull a tool-capable model sized to your RAM)
LLM_MODEL=llama3.1:8b

# Only used when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# LeetCode public profile to pull daily stats for (Phase 2)
LEETCODE_USERNAME=

# Live stock quotes (Phase 4) — one of these. Ticker-click price HISTORY
# needs neither: it comes from yahoo-finance2 with no API key.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# Google OAuth — Calendar (Phase 4), Gmail triage (Phase 9), Drive
# (GoodNotes sync, Phase 18; needs the drive.readonly scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Obsidian vault (Phase 4)
OBSIDIAN_VAULT_PATH=

# Semantic search embeddings (Phase 20/21) — Ollama embedding model
EMBED_MODEL=nomic-embed-text

# Slack morning check-in (Phase 7)
# Bot token (xoxb-…) with chat:write + im:write; your Slack member ID (U…)
SLACK_BOT_TOKEN=
SLACK_USER_ID=
# Signing secret — only needed for the INBOUND events webhook (deferred
# behind a tunnel; see HANDOFF.md)
SLACK_SIGNING_SECRET=

# Textbook RAG sidecar (Phase 16) — sidecars/textbook-rag
TEXTBOOK_RAG_URL=http://localhost:8016

# Macro sidecar (Phase 17) — sidecars/macro; used by the /status probe
MACRO_SIDECAR_URL=http://localhost:8017

# Voice sidecar (Phase 21) — sidecars/voice; mic button transcription
VOICE_SIDECAR_URL=http://localhost:8018

# GoodNotes → RAG sync (Phase 18) — Drive folder GoodNotes backs up to
GOODNOTES_DRIVE_FOLDER=GoodNotes Backup

# ActivityWatch screen-time sidecar (optional, third-party app)
AW_BASE_URL=http://localhost:5600

# Remote access / PWA (Phase 21) — set to require a bearer token on every
# page/API request (e.g. serving over Tailscale). Unset = no-op locally.
JARVIS_AUTH_TOKEN=

# Device sync (Phase 21, optional) — "host" or "client"; unset disables sync
SYNC_ROLE=
# Client only — the host's Tailscale address, e.g. http://home-pc:3000
SYNC_HOST_URL=
# Shared secret, required on both sides — keep this behind Tailscale only
SYNC_AUTH_TOKEN=
# Optional stable machine id; auto-generated and persisted on first run if unset
DEVICE_ID=
