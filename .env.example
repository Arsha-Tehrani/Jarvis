# Jarvis env vars — copy to .env.local and fill in. Never commit .env.local.

# --- LLM provider ---
# "ollama" (default, local) or "anthropic"
LLM_PROVIDER=ollama
# OpenAI-compatible base URL for Ollama
LLM_BASE_URL=http://localhost:11434/v1
# Model served by the provider above (code defaults: llama3.1:8b for ollama, claude-sonnet-5 for anthropic)
LLM_MODEL=llama3.1:8b
# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Market data (one of the two free tiers) ---
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

# --- Google Calendar OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LeetCode ---
LEETCODE_USERNAME=

# --- Notes (absolute path to your Obsidian vault) ---
OBSIDIAN_VAULT_PATH=/absolute/path/to/ObsidianVault

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_USER_ID=
SLACK_SIGNING_SECRET=

# --- Sidecars ---
# Textbook RAG sidecar (sidecars/textbook-rag), used by the ask_textbook tool
TEXTBOOK_RAG_URL=http://localhost:8016
